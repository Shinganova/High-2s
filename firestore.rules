rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each player can read and write only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared progressive jackpots — any signed-in player may READ the live pool,
    // but only Cloud Functions (admin SDK, which bypasses these rules) may WRITE
    // it. This makes the shared pool tamper-proof: clients can't set arbitrary
    // values; all growth/payout goes through the validated callable functions.
    match /jackpots/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
