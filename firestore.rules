rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each player can read and write only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared progressive jackpots — any signed-in player may read and
    // contribute to / reset the global pool. (Play money; values are not
    // trusted as authoritative for anything but display.)
    match /jackpots/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
